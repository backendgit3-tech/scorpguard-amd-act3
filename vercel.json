{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "daemons": {
    "celery-worker": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "command": ["celery", "-A", "app.core.celery_app.celery_app", "worker", "--loglevel=info", "--pool=solo"],
      "replicas": { "iad1": 1 }
    }
  }
}